# Copy to .env beside compose.yml. Compose reads it for the values below; none
# of it reaches the containers.

# Where the web UI and the upload server listen on the host. Loopback suits a
# reverse proxy on the same machine.
CHAMPCTL_SERVE_LISTEN=127.0.0.1:3000
CHAMPCTL_UPLOAD_LISTEN=127.0.0.1:8477

# The championship the livery drain applies uploads to. Only needed with
# --profile discord; change it when a new championship starts.
CHAMPCTL_LIVERY_CHAMPIONSHIP=

# Set to use a prebuilt image instead of building from this checkout.
# CHAMPCTL_IMAGE=champctl:local
