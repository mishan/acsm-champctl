# Copy to docker/.env. The real .env is gitignored.

# Image to run for the default (premium) service. Drop a release zip in
# docker/premium/ and build it with `npm run harness:build` — compose owns the
# build, so building by hand skips whatever build args it passes.
ACSM_IMAGE=champctl/acsm-premium:local

# Image for the `oss` profile. Pinned rather than :latest so recon captures
# stay comparable — change it deliberately, not by rebuilding on a Tuesday.
ACSM_OSS_IMAGE=seejy/assetto-server-manager:v1.7.9

# Where to bind. Keep this on loopback unless you are deliberately exposing
# the harness — the container holds an admin account with a password you have
# written down in a file.
BIND_ADDR=127.0.0.1
ACSM_PORT=8772
ACSM_OSS_PORT=8773

# ---------------------------------------------------------------------------
# Steam. An Assetto Corsa server has to come from somewhere — Server Manager
# runs steamcmd whenever the install path has no executable in it, and blank
# credentials don't prevent that, they just make it fail with "exit status 4".
#
# Easiest route needs nothing here at all:
#
#     npm run harness:steam-login-qr
#
# Scan the QR with the Steam mobile app. It downloads the server into the
# volume Server Manager reads, and then the container starts with no
# credentials configured.
#
# Otherwise fill these in. If the account has Steam Guard on, run
# `npm run harness:steam-login` once first so steamcmd can cache the session.
#
# Either way the account must OWN Assetto Corsa: appid 302550 answers
# "No subscription" to an anonymous login. Stock content only — BATL's mod
# tracks still need the `scan` pit-count source (plan §4.5).
# ---------------------------------------------------------------------------
STEAM_USERNAME=
STEAM_PASSWORD=
# Exactly true or false. This lands in config.yml unquoted, as a YAML boolean,
# so the entrypoint refuses to start on anything else rather than let a typo
# become a parse error — or a silently-wrong setting — later. Capitalisation
# and surrounding spaces are forgiven; `yes` and `1` are not.
STEAM_FORCE_UPDATE=false

# ---------------------------------------------------------------------------
# Credentials the recon scripts and live tests use. These are for the
# throwaway container ONLY. Never put a real league's credentials here.
# ---------------------------------------------------------------------------
CHAMPCTL_LIVE_URL=http://127.0.0.1:8772
CHAMPCTL_LIVE_USERNAME=admin
# Set this to whatever you chose when ACSM forced a password change on first
# login. The initial login is admin / servermanager.
CHAMPCTL_LIVE_PASSWORD=
