# Copy to docker/.env. The real .env is gitignored.

# Image to run for the default (premium) service. Build it with:
#   docker build -f Dockerfile.premium -t champctl/acsm-premium:local .
ACSM_IMAGE=champctl/acsm-premium:local

# Where to bind. Keep this on loopback unless you are deliberately exposing
# the harness — the container holds an admin account with a password you have
# written down in a file.
BIND_ADDR=127.0.0.1
ACSM_PORT=8772
ACSM_OSS_PORT=8773

# ---------------------------------------------------------------------------
# Assetto Corsa content.
#
# Leave these blank for a content-free container. Import, export and every form
# recon target work fine without content, and it boots in seconds.
#
# Fill them in when you need track pit counts: Server Manager will use steamcmd
# to install the Assetto Corsa dedicated server, which is free but needs an
# account that owns Assetto Corsa. Expect several minutes on first boot, and
# use an account with SteamGuard disabled — steamcmd cannot prompt for a code
# from inside the container.
#
# This installs stock content only. BATL's mod tracks still need the `scan`
# pit-count source (plan §4.5).
# ---------------------------------------------------------------------------
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_FORCE_UPDATE=false

# ---------------------------------------------------------------------------
# Credentials the recon scripts and live tests use. These are for the
# throwaway container ONLY. Never put a real league's credentials here.
# ---------------------------------------------------------------------------
CHAMPCTL_LIVE_URL=http://127.0.0.1:8772
CHAMPCTL_LIVE_USERNAME=admin
# Set this to whatever you chose when ACSM forced a password change on first
# login. The initial login is admin / servermanager.
CHAMPCTL_LIVE_PASSWORD=
