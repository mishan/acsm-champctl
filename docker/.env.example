# Copy to docker/.env. The real .env is gitignored.

# Image to run for the default (premium) service. Build it with:
#   docker build -f Dockerfile.premium -t champctl/acsm-premium:local .
ACSM_IMAGE=champctl/acsm-premium:local

# Where to bind. Keep this on loopback unless you are deliberately exposing
# the harness — the container holds an admin account with a password you have
# written down in a file.
BIND_ADDR=127.0.0.1
ACSM_PORT=8772
ACSM_OSS_PORT=8773

# ---------------------------------------------------------------------------
# Steam credentials. REQUIRED — there is no content-free mode.
#
# Server Manager runs steamcmd whenever the install path has no executable in
# it, and blank credentials don't prevent that, they just make it fail with
# "exit status 4". Anonymous doesn't work either: appid 302550 answers
# "No subscription", so the account has to own Assetto Corsa. The dedicated
# server itself is a free download.
#
# If the account has Steam Guard on, don't turn it off — run
# `npm run harness:steam-login` once with a terminal attached. It does the
# login and the download together and caches credentials in the acsm-steam
# volume, so later boots work non-interactively.
#
# Stock content only. BATL's mod tracks still need the `scan` pit-count
# source (plan §4.5).
# ---------------------------------------------------------------------------
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_FORCE_UPDATE=false

# ---------------------------------------------------------------------------
# Credentials the recon scripts and live tests use. These are for the
# throwaway container ONLY. Never put a real league's credentials here.
# ---------------------------------------------------------------------------
CHAMPCTL_LIVE_URL=http://127.0.0.1:8772
CHAMPCTL_LIVE_USERNAME=admin
# Set this to whatever you chose when ACSM forced a password change on first
# login. The initial login is admin / servermanager.
CHAMPCTL_LIVE_PASSWORD=
