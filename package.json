{
  "name": "acsm-champctl",
  "version": "0.1.0",
  "private": true,
  "description": "Championship creation, validation and stats for Assetto Corsa Server Manager",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "gridmom": "./bin/gridmom.js",
    "champctl-archive": "./bin/champctl-archive.js",
    "champctl-finalize": "./bin/champctl-finalize.js",
    "champctl-month": "./bin/champctl-month.js"
  },
  "//files": "dist/ is in .gitignore, and without an explicit list npm packs by gitignore rules — so the tarball shipped bin/ scripts importing a directory that wasn't in it. README and LICENSE come along whatever this says.",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "//prepare": "bin/ runs the compiled output, so an install has to compile. prepare covers both routes npm takes: it runs on npm install from a git URL, and before npm pack or publish.",
    "prepare": "npm run build",
    "gridmom": "tsx src/cli/gridmom.ts",
    "archive": "tsx src/cli/archive.ts",
    "finalize": "tsx src/cli/finalize.ts",
    "month": "tsx src/cli/month.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness:build": "docker compose --project-directory docker build",
    "harness:up": "docker compose --project-directory docker up -d",
    "harness:down": "docker compose --project-directory docker down",
    "harness:reset": "docker compose --project-directory docker down -v && docker compose --project-directory docker up -d",
    "harness:logs": "docker compose --project-directory docker logs -f",
    "harness:steam-login-qr": "bash docker/steam-login-qr.sh",
    "harness:steam-login": "bash docker/steam-login.sh",
    "harness:steam-check": "docker compose --project-directory docker run --rm --entrypoint steamcmd acsm +quit",
    "test:live": "vitest run --config vitest.live.config.ts",
    "recon:forms": "tsx scripts/recon/forms.ts",
    "recon:roundtrip": "tsx scripts/recon/roundtrip.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "luxon": "^3.5.0",
    "undici": "^7.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
